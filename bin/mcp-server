#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * moo-cloud-cli mcp-server —— 把云端的 HTTP MCP 包成本地 stdio MCP。
 *
 * 目的：Codex / WorkBuddy / Claude Desktop / Cursor 等客户端只需要
 *   command = php
 *   args    = [/path/to/bin/mcp-server]
 * 就能拿到 list_projects / list_issues / get_todo / resolve_issue 等工具；
 * URL、Bearer token、超时都收在这一个进程里，不用逐客户端配置。
 *
 * 协议：stdio + 每行一条 JSON-RPC（MCP 的 stdio 传输）。
 * 行为：
 *   - 有 id 的请求：转发到云端并把响应原样写回一行；
 *   - 通知（无 id）：只转发，不写 stdout（写空行会污染客户端解析）；
 *   - 网络失败：返回 JSON-RPC error，保持同一 id，客户端能看到原因。
 *
 * 凭据：--token / MOO_CLOUD_MCP_TOKEN / ~/.config/moo-fleet/mcp-token。
 */

date_default_timezone_set('Asia/Shanghai');

$args = array_slice($argv, 1);
if (in_array('--help', $args, true) || in_array('-h', $args, true)) {
    fwrite(STDOUT, "mcp-server：把云端 HTTP MCP 包成本地 stdio MCP\n\n用法: bin/mcp-server [--token=...] [--cloud=...]\n");
    exit(0);
}

$opts = parseOptions($args);
$token = $opts['token'] !== '' ? $opts['token'] : initialToken();
if ($token === '') {
    fwrite(STDERR, "mcp-server: 缺少 token（--token / MOO_CLOUD_MCP_TOKEN / ~/.config/moo-fleet/mcp-token）\n");

    exit(1);
}

$cloud = rtrim($opts['cloud'] !== '' ? $opts['cloud'] : (getenv('MOO_CLOUD_URL') ?: 'https://c.mooeen.com'), '/');
$endpoint = $cloud.'/api/v1/mcp';

while (($line = fgets(STDIN)) !== false) {
    $line = trim($line);
    if ($line === '') {
        continue;
    }

    $message = json_decode($line, true);
    if (! is_array($message)) {
        // 无法解析的输入直接丢弃：写回任何东西都可能让客户端当成协议错误。
        fwrite(STDERR, "mcp-server: 忽略非 JSON 输入\n");

        continue;
    }

    $id = $message['id'] ?? null;
    $response = forward($endpoint, $token, $line, $id);

    if ($id !== null && is_array($response)) {
        // 云端错误偶尔不带 id；补上请求 id，客户端才不会把它当成无主消息丢掉。
        if (! isset($response['id'])) {
            $response['id'] = $id;
        }
        fwrite(STDOUT, json_encode($response, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES)."\n");
        fflush(STDOUT);
    }
}

exit(0);

/** @return array<string, mixed> */
function parseOptions(array $args): array
{
    $opts = ['token' => '', 'cloud' => ''];

    foreach ($args as $arg) {
        if (! str_starts_with($arg, '--')) {
            continue;
        }
        [$key, $value] = array_pad(explode('=', substr($arg, 2), 2), 2, '');
        if (array_key_exists($key, $opts)) {
            $opts[$key] = $value;
        }
    }

    return $opts;
}

function initialToken(): string
{
    $env = getenv('MOO_CLOUD_MCP_TOKEN');
    if (is_string($env) && trim($env) !== '') {
        return trim($env);
    }

    $home = getenv('HOME') ?: '';
    $file = $home.'/.config/moo-fleet/mcp-token';
    if ($home !== '' && is_file($file)) {
        return trim((string) file_get_contents($file));
    }

    return '';
}

/** 转发一条 JSON-RPC；失败时合成同 id 的 error，避免客户端一直等。 */
function forward(string $endpoint, string $token, string $body, mixed $id): ?array
{
    $ch = curl_init($endpoint);
    curl_setopt_array($ch, [
        CURLOPT_POST => true,
        CURLOPT_POSTFIELDS => $body,
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_CONNECTTIMEOUT => 10,
        CURLOPT_TIMEOUT => 120,
        CURLOPT_HTTPHEADER => [
            'Content-Type: application/json',
            'Accept: application/json, text/event-stream',
            'Authorization: Bearer '.$token,
        ],
    ]);

    $raw = curl_exec($ch);
    $error = curl_error($ch);
    $status = (int) curl_getinfo($ch, CURLINFO_HTTP_CODE);
    curl_close($ch);

    if ($raw === false) {
        return rpcError($id, -32603, '云端不可达：'.$error);
    }

    $decoded = json_decode((string) $raw, true);
    if (! is_array($decoded)) {
        return rpcError($id, -32603, "云端返回非 JSON（HTTP {$status}）");
    }

    return $decoded;
}

/** @return array<string, mixed> */
function rpcError(mixed $id, int $code, string $message): array
{
    return ['jsonrpc' => '2.0', 'id' => $id, 'error' => ['code' => $code, 'message' => $message]];
}
